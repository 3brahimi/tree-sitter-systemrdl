{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "systemrdl",
      "camelcase": "SystemRDL",
      "title": "SystemRDL",
      "scope": "source.systemrdl",
      "file-types": [
        "rdl"
      ],
      "injection-regex": "^systemrdl$",
      "class-name": "TreeSitterSystemRDL"
    }
  ],
  "metadata": {
    "version": "0.10.1",
    "license": "MIT",
    "description": "SystemRDL 2.0 grammar for tree-sitter",
    "authors": [
      {
        "name": "Aliaksei Chapyzhenka"
      }
    ],
    "links": {
      "repository": "https://github.com/3brahimi/tree-sitter-systemrdl"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": true,
    "rust": false,
    "swift": false,
    "zig": false
  }
}